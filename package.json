{
  "name": "dsh-pick",
  "version": "0.6.2",
  "description": "帮你在 DSH 生态里选对插件：说需求 → 找候选 → 多维比较 → 出结论。下载量是证据，AI 是推理。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/dsh-pick.git"
  },
  "homepage": "https://github.com/AIcivilization/dsh-pick#readme",
  "bugs": {
    "url": "https://github.com/AIcivilization/dsh-pick/issues"
  },
  "type": "module",
  "main": "./plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-pick": "bin/dsh-pick.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "release": "node scripts/release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "catalog": {
      "category": "tool",
      "summary": {
        "en": "Pick DSH plugins: an overall ranking that merges several plugin markets, denoised download metrics, GitHub data, one-click install.",
        "zh": "选 DSH 插件：合并几个插件市场的综合榜、去噪后的下载指标、GitHub 数据，榜上一键安装。"
      },
      "capabilities": [
        "webServer",
        "pluginManager",
        "pluginMarket",
        "tools",
        "sidebarRight",
        "sessions",
        "network"
      ]
    }
  },
  "files": [
    "bin",
    "lib",
    "plugin",
    "web",
    "data",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-plugins",
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "deepseek",
    "cordis",
    "plugin",
    "plugin-directory",
    "plugin-advisor",
    "pick",
    "npm-stats",
    "plugin-market",
    "marketplace",
    "plugin-manager"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-alpha.4"
  }
}
