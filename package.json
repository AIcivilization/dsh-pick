{
  "name": "dsh-pick",
  "version": "0.4.3",
  "description": "帮你在 DSH 生态里选对插件：说需求 → 找候选 → 多维比较 → 出结论。下载量是证据，AI 是推理。",
  "type": "module",
  "main": "./plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-pick": "bin/dsh-pick.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "release": "node scripts/release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "bin",
    "lib",
    "plugin",
    "web",
    "data",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-plugins",
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "deepseek",
    "cordis",
    "plugin",
    "plugin-directory",
    "plugin-advisor",
    "pick",
    "npm-stats",
    "plugin-market"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
